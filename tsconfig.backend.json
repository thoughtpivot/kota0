{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "koa-bodyparser"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["app/src/*"],
      "@shared/*": ["shared/*"]
    },
    "resolveJsonModule": true
  },
  "include": [
    "app/src/**/*.backend.ts",
    "app/src/lib/scribe.ts",
    "app/src/subjects/plan/planRun.ts",
    "app/src/subjects/plan/kota0IdeationRun.ts",
    "app/src/subjects/kota0/ScribeKota0AppRepository.ts",
    "app/src/subjects/kota0/ScribeKota0ChatRepository.ts",
    "app/src/subjects/kota0/scribeKota0History.ts",
    "app/src/subjects/kota0/kota0Materialize.ts",
    "app/src/subjects/kota0/kota0SfcTailwindSanitize.ts",
    "app/src/subjects/kota0/kota0ChatTypes.ts",
    "app/src/subjects/kota0/kota0ChatForModel.ts",
    "app/src/subjects/kota0/kota0WorkspaceDepsSummary.ts",
    "app/src/subjects/kota0/kota0SfcHeadOutline.ts",
    "app/src/lib/geminiModel.ts",
    "app/src/subjects/kota0/kota0AppTypes.ts",
    "app/src/types/chat.ts",
    "shared/**/*.ts"
  ]
}
