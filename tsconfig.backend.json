{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "koa-bodyparser"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["app/src/*"],
      "@shared/*": ["shared/*"]
    },
    "resolveJsonModule": true
  },
  "include": [
    "app/src/**/*.backend.ts",
    "app/src/lib/scribe.ts",
    "app/src/components/kota0/ai/plan/planRun.ts",
    "app/src/components/kota0/ai/plan/ideationRun.ts",
    "app/src/components/kota0/apps/data/AppRepository.ts",
    "app/src/components/kota0/apps/data/appScribeComponents.ts",
    "app/src/components/kota0/apps/data/appScribeComponents.test.ts",
    "app/src/components/kota0/ai/chat/ChatRepository.ts",
    "app/src/components/kota0/ai/chat/history.ts",
    "app/src/components/kota0/ai/chat/revisionActivity.ts",
    "app/src/components/kota0/viewer/materialize/materialize.ts",
    "app/src/components/kota0/deploy/**/*.ts",
    "app/src/components/kota0/viewer/sfc/sfcTailwindSanitize.ts",
    "app/src/components/kota0/ai/chat/chatTypes.ts",
    "app/src/components/kota0/ai/chat/chatForModel.ts",
    "app/src/components/kota0/viewer/materialize/appBackendForFlight.ts",
    "app/src/components/kota0/viewer/materialize/appBackendForFlight.test.ts",
    "app/src/components/kota0/viewer/deps/workspaceDepsSummary.ts",
    "app/src/components/kota0/viewer/sfc/sfcHeadOutline.ts",
    "app/src/components/kota0/viewer/host/bundlePreviewConstants.ts",
    "app/src/components/kota0/viewer/host/bundlePreviewHtmlRewrite.ts",
    "app/src/lib/geminiModel.ts",
    "app/src/components/kota0/ai/audio/geminiTranscribeAudio.ts",
    "app/src/components/kota0/ai/provider/workspaceAiCompletion.ts",
    "app/src/components/kota0/ai/provider/workspaceAiCompletion.test.ts",
    "app/src/components/kota0/apps/data/appTypes.ts",
    "app/src/components/kota0/apps/icons/appIconIds.ts",
    "app/src/components/kota0/apps/icons/appIconRandom.ts",
    "app/src/components/kota0/apps/icons/randomizeAppIcons.script.ts",
    "app/src/components/kota0/ai/chat/chat.types.ts",
    "app/src/components/kota0/ai/chat/chatPhase.ts",
    "app/src/components/kota0/ai/patch/applyModelPatches.ts",
    "app/src/components/kota0/viewer/host/bundlePreviewGuard.ts",
    "app/src/components/kota0/viewer/host/bundleFlightIdentity.ts",
    "shared/**/*.ts",
    "scripts/pushKota0BackendToScribe.ts",
    "scripts/start-scribe-gateway.ts",
    "app/src/components/kota0/gateway/**/*.ts"
  ],
  "exclude": [
    "app/src/components/kota0/deploy/panel/deployApi.ts",
    "app/src/components/kota0/deploy/panel/DeployPanel.vue"
  ]
}
